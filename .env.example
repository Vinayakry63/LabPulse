# Copy to .env (docker compose reads it automatically). Everything is optional for a local demo.

# --- AI assistant ---------------------------------------------------------
# Without a key the app uses an offline mock provider (works, but answers are crude).
OPENAI_API_KEY=
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

